<?xml version="1.0"?>
<ruleset name="NPPP PHP Compatibility">
    <description>
        Verify NPPP compatibility with supported PHP versions.
    </description>

    <config name="testVersion" value="7.4-8.4"/>

    <arg name="extensions" value="php"/>
    <arg name="basepath" value="."/>
    <arg name="colors"/>

    <rule ref="PHPCompatibilityWP"/>

    <file>.</file>

    <exclude-pattern>*/vendor/*</exclude-pattern>
</ruleset>
